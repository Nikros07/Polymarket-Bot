# ============================================================
# OASIS AI Decision System — Environment Configuration
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git.
# ============================================================

# ── LLM Provider (OpenRouter — free tier) ──────────────────
LLM_PROVIDER=openrouter
# Free models available at openrouter.ai/models (filter: free)
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Alternatives (all free):
#   deepseek/deepseek-r1:free
#   deepseek/deepseek-chat-v3-0324:free
#   google/gemma-2-9b-it:free
#   mistralai/mistral-7b-instruct:free

# ── OpenRouter API Key ─────────────────────────────────────
# Get free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Research: Tavily AI Search ─────────────────────────────
# Get free key at: https://tavily.com
TAVILY_API_KEY=tvly-your-key-here

# ── Legacy providers (leave empty if using OpenRouter) ─────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=

# ── App ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# Set DEMO_MODE=true to run without any API keys (simulated responses)
DEMO_MODE=false

# ── Database ────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/decisions.db

# ── Scoring Thresholds ──────────────────────────────────────
BET_EDGE_THRESHOLD=0.10
BET_CONFIDENCE_THRESHOLD=0.65
WATCH_EDGE_THRESHOLD=0.03
MAX_RISK_FOR_BET=0.70

# ── Agent Behaviour ─────────────────────────────────────────
AGENT_TEMPERATURE=0.7
MAX_RESEARCH_SOURCES=5
ENABLE_MEMORY=true
