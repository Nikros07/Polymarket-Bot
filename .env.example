# ================================
# AI Decision System Configuration
# ================================

# --- LLM Provider ---
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=claude-opus-4-6       # claude-opus-4-6 | gpt-4o

# --- API Keys ---
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# --- Research Services (optional, enhances research quality) ---
SERPER_API_KEY=your_serper_key_here   # Google Search via Serper.dev
TAVILY_API_KEY=your_tavily_key_here   # Tavily AI Search

# --- App Config ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
DEMO_MODE=false                 # Set true to run without API keys (simulated responses)

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/decisions.db

# --- Scoring Thresholds ---
BET_EDGE_THRESHOLD=0.10        # Minimum edge to recommend BET
BET_CONFIDENCE_THRESHOLD=0.65  # Minimum confidence to recommend BET
WATCH_EDGE_THRESHOLD=0.03      # Minimum edge to recommend WATCH
MAX_RISK_FOR_BET=0.70          # Maximum risk level for BET recommendation

# --- Agent Behavior ---
AGENT_TEMPERATURE=0.7          # LLM temperature for agents (0.0-1.0)
MAX_RESEARCH_SOURCES=5         # Max web sources per research cycle
ENABLE_MEMORY=true             # Enable cross-session memory
