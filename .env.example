# ============================================================
# AI Decision System — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ── LLM Provider ──────────────────────────────────────────────
LLM_PROVIDER=openrouter         # anthropic | openai | openrouter
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

#   Free OpenRouter models (no cost, get key at openrouter.ai):
#     meta-llama/llama-3.1-8b-instruct:free   ← recommended (best balance)
#     mistralai/mistral-7b-instruct:free
#     google/gemma-2-9b-it:free
#     qwen/qwen-2.5-7b-instruct:free
#
#   Paid models (better quality):
#     anthropic/claude-3.5-sonnet  (with LLM_PROVIDER=openrouter)
#     openai/gpt-4o-mini           (with LLM_PROVIDER=openrouter)
#     claude-opus-4-6              (with LLM_PROVIDER=anthropic)
#     gpt-4o                       (with LLM_PROVIDER=openai)

LLM_MAX_TOKENS=2048             # Max output tokens per agent call
                                # Free OpenRouter models: keep at 2048 or below

# ── API Keys ──────────────────────────────────────────────────
# OpenRouter — free tier (no credit card, just sign up at openrouter.ai)
OPENROUTER_API_KEY=             # sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct providers (only needed if NOT using OpenRouter)
ANTHROPIC_API_KEY=              # Get at console.anthropic.com
OPENAI_API_KEY=                 # Get at platform.openai.com

# ── Research (Tavily — recommended) ───────────────────────────
TAVILY_API_KEY=                 # Get at tavily.com (free tier: 1000 req/month)
TAVILY_MAX_RESULTS=4            # Keep low to save API credits
TAVILY_SEARCH_DEPTH=basic       # basic=1 credit | advanced=2 credits

SERPER_API_KEY=                 # Google Search fallback (serper.dev)

# ── Demo Mode (no API keys needed) ────────────────────────────
DEMO_MODE=false                 # Set true to run with simulated responses

# ── App ───────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ── Polymarket ────────────────────────────────────────────────
POLYMARKET_FEE_RATE=0.02        # Polymarket trading fee deducted from edge (2%)
POLYMARKET_MIN_VOLUME=500       # Hide markets below this USD volume
POLYMARKET_MAX_MARKETS=5        # Max markets per search result

# ── Position Sizing (Kelly Criterion) ─────────────────────────
KELLY_FRACTION=0.25             # Stake sizing multiplier applied to full Kelly:
                                #   0.25 = quarter-Kelly  ← safe default
                                #   0.50 = half-Kelly     (moderate)
                                #   1.00 = full Kelly     (aggressive, high variance)

# ── Scoring Thresholds ────────────────────────────────────────
# Thresholds apply to adjusted_edge = (fee-adjusted edge) × confidence
BET_EDGE_THRESHOLD=0.10         # Min adjusted edge for BET recommendation
BET_CONFIDENCE_THRESHOLD=0.65   # Min confidence for BET
WATCH_EDGE_THRESHOLD=0.03       # Min edge for WATCH
MAX_RISK_FOR_BET=0.70           # Max risk level allowed for BET
